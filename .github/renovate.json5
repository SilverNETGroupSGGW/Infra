{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // GitHub Actions (pinned by SHA), mise.toml tools and Terraform providers.
  extends: ['config:recommended'],
  // Refreshes the .terraform.lock.hcl hashes; not automerged because it can
  // also move providers, including the Google Play one.
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      // Merged after CI passes and the release is three days old, so a hijacked
      // release is likely pulled before it lands; majors wait for a review.
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      minimumReleaseAge: '3 days',
      automerge: true,
    },
    {
      // A single maintainer's provider with access to Play Console: every
      // update waits for a review.
      matchPackageNames: ['oliver-binns/googleplay'],
      automerge: false,
    },
  ],
}
